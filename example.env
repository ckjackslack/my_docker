# Template for .env (read automatically by `docker compose` from the project directory).
# Create a real .env with random secrets:   my-docker env
# Every value set to `change-me` is replaced by a freshly generated secret.

# --- PostgreSQL superuser (used by the db container and pgAdmin logins) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Application database role (created by init-script.sh on first start) ---
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# --- App image ---
APP_DIR=app
PYTHON_VERSION=3.12
INSTALL_DEV_TOOLS=1
TZ=UTC

# --- Host ports (all bound to 127.0.0.1) ---
APP_PORT=8000
DB_PORT=5432
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025
PGADMIN_PORT=5050
REDIS_PORT=6379
FRONTEND_PORT=8080
NGINX_PORT=80
VAULT_PORT=8200

# --- profile: tools (pgAdmin) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- profile: worker (Redis + Celery) ---
CELERY_APP=app
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- profile: frontend ---
FRONTEND_DIR=frontend
NODE_VERSION=20
FRONTEND_NPM_SCRIPT=serve

# --- profile: proxy (nginx) ---
NGINX_SERVER_NAME=localhost
NGINX_CLIENT_MAX_BODY_SIZE=20m

# --- profile: vault (dev mode) ---
VAULT_DEV_ROOT_TOKEN=change-me
