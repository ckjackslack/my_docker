# Node development image for the optional `frontend` compose profile.
# Build context is the repository root; FRONTEND_DIR selects the frontend directory.
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-slim

ARG FRONTEND_DIR=frontend

WORKDIR /app

# npm script started by the container (`serve` for Vue CLI, `dev` for Vite, ...).
ENV NPM_SCRIPT=serve

COPY ${FRONTEND_DIR}/package*.json ./
RUN npm install

COPY ${FRONTEND_DIR}/ ./

EXPOSE 8080

CMD ["sh", "-c", "exec npm run \"$NPM_SCRIPT\""]
